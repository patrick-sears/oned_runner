#

!create_install_location ; true
# Should be true for others.
# But for prs, should be false
# so that a symlink is created instead
# to place it on a separate partition.

!install_location  ; /usr/local/share/prs_system
!final_dir         ; oned_runner-0.1

!run_call_location ; /usr/local/bin
!run_call          ; prs-oned_runner-0.1

!user_config ; ~/.config/prs_system/oned_runner-0.1.config
# Gives location of user's works space (wosp).
# This file won't be created until the user first
# runs the program.
# Cannot be changed after install.
# Needs to be a separate location for each user.
# ~ will expand to the user's home directory.
# This location will be saved in the install dir
# in z-install.config.

!user_wosp   ; ~/wosp/prs/oned_runner-0.1
# Gives the location of the user's work spaced.
# This dir won't be created until the user first
# runs the program.
# Can be changed after install.
# Needs to be a separate location for each user.
# ~ will expand to the user's home directory.


!venv_name ; oned
!venv_location ; /mnt/udata/prs_system/python-venv



